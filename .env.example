# Recommended .env.local: anonymous, production-public reads only.
APP_ENV=local
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: keeps local metadata links pointed at the deployed canonical origin.
NEXT_PUBLIC_CANONICAL_SITE_URL=https://your-custom-domain.example

NEXT_PUBLIC_SUPABASE_URL=https://mgfnosozkomhinsaztbs.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<production publishable key>

# These must remain empty locally. Production values belong in the protected
# deployment environment (or an ignored .env.production.local for operator use).
SUPABASE_SERVICE_ROLE_KEY=
GROQ_API_KEY=
UNSPLASH_ACCESS_KEY=
CRON_SECRET=

NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
GOOGLE_SITE_VERIFICATION=

NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_CONSENT_READY=false
NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT=
NEXT_PUBLIC_GOOGLE_ADSENSE_ARTICLE_SLOT=

# Production-only queue/provider controls (defaults shown).
READY_QUEUE_TARGET=18
READY_QUEUE_MINIMUM=8
READY_QUEUE_MAXIMUM=30
REPLENISH_NORMAL_CANDIDATES=6
REPLENISH_LOW_CANDIDATES=12
REPLENISH_CRITICAL_CANDIDATES=18
MAX_GROQ_CANDIDATES_CRITICAL=3
MAX_GROQ_CANDIDATES_LOW=2
MAX_GROQ_CANDIDATES_NORMAL=1
GROQ_RUN_TOKEN_BUDGET=45000
GROQ_DAILY_TOKEN_BUDGET=180000
GROQ_DAILY_TOKENS_USED=0
